{
  "name": "onyq-website",
  "version": "0.1.0",
  "private": true,
  "description": "ONYQ multi-page website (Next.js App Router).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --disable-warning=ExperimentalWarning --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-messages.mjs",
    "admin": "node --disable-warning=ExperimentalWarning scripts/admin.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.4.3",
    "next-intl": "4.14.8",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/noto-sans-armenian": "5.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
