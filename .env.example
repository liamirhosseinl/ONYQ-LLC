# production (default) = the live site; "preview" shows approval markers and blocks indexing
NEXT_PUBLIC_SITE_MODE=production
# canonical origin, no trailing slash
NEXT_PUBLIC_SITE_URL=https://onyq.am

# Enquiry delivery — configure ONE of the options below (see lib/enquiry-delivery.ts)
# Option A: webhook
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Option B: email via Resend
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Admin panel & analytics database (SQLite). Must be a persistent, private, backed-up folder.
# Default: ./storage. In Docker: /data (mounted volume).
ONYQ_DATA_DIR=
# Set to 1 ONLY when the site sits behind Cloudflare (and the origin accepts only Cloudflare IPs).
ONYQ_TRUST_CLOUDFLARE=
# Set to 1 when the app runs behind our reverse proxy (Caddy/nginx), which overwrites client-IP headers.
# The Docker image sets it. Never set it if the app's port is reachable directly from the internet.
ONYQ_TRUST_PROXY=
